{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/about",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/about/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/blog",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/blog/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/rss+xml"
        },
        {
          "key": "Link",
          "value": "</>; rel=alternate, </feed.xml>; rel=self"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/old",
      "destination": "/new",
      "statusCode": 301
    },
    {
      "source": "/old/",
      "destination": "/new",
      "statusCode": 301
    },
    {
      "source": "/blog/:slug",
      "destination": "/posts/:slug",
      "statusCode": 308
    },
    {
      "source": "/blog/:slug/",
      "destination": "/posts/:slug",
      "statusCode": 308
    },
    {
      "source": "/blog/:slug/feed",
      "destination": "/posts/:slug/feed.xml",
      "statusCode": 308
    },
    {
      "source": "/blog/:slug/feed/",
      "destination": "/posts/:slug/feed.xml",
      "statusCode": 308
    },
    {
      "source": "/docs/:rest+",
      "destination": "/manual/:rest+",
      "statusCode": 301
    },
    {
      "source": "/docs/:rest+/",
      "destination": "/manual/:rest+",
      "statusCode": 301
    }
  ]
}
